{
  "manifest_version": 3,
  "name": "netKonnect Service Insight for Chrome",
  "version": "1.0.0",
  "description": "Share request hostnames, server IPs and page hostname context with netKonnect on this computer.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "webRequest",
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "netKonnect Service Insight",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
